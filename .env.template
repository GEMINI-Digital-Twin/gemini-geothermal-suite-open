# Copy this file to `.env` in the repo root, then fill in the blanks (see
# the Quick Start guide: src/gemini_documentation/source/start_installation_quickstart.rst).
#
# This single .env file is read by BOTH `docker compose` (via `env_file:` in
# docker-compose.yml) and the Python app (via python-dotenv).
#
# ============================================================================
# REQUIRED -- needed to run the GUI, the framework/models, and the analysis
# tabs that depend on Celery (ESP, production well performance, injection
# well monitoring, well integrity monitoring).
# ============================================================================

# Plant to load: name of a folder under gemini-project/, e.g. "geothermal_example".
GEMINI_PLANT=

# Flask web app.
GEMINI_FRONTEND_PORT=
GEMINI_ADMIN_EMAIL=
GEMINI_ADMIN_NAME=
GEMINI_ADMIN_PASSWORD=

# MySQL (user/project metadata). GEMINI_MYSQLDB_URL is the hostname the app
# connects to: "localhost" if you run the app with `poetry run`, or the
# compose service name "mysqldb" if the app itself also runs inside Docker.
# MYSQL_ROOT_PASSWORD must be "root" -- it is hardcoded to match in
# src/gemini_interface/create_app.py.
GEMINI_MYSQLDB_URL=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=

# InfluxDB (time-series process data). INFLUXDB_* is read by the app;
# DOCKER_INFLUXDB_INIT_* configures the influxdb container's one-time setup
# wizard -- keep ORG/BUCKET/USERNAME/PASSWORD identical between the two groups.
INFLUXDB_URL=
INFLUXDB_ORG=
INFLUXDB_USERNAME=
INFLUXDB_PASSWORD=
INFLUXDB_BUCKET=

DOCKER_INFLUXDB_INIT_MODE=
DOCKER_INFLUXDB_INIT_ORG=
DOCKER_INFLUXDB_INIT_BUCKET=
DOCKER_INFLUXDB_INIT_USERNAME=
DOCKER_INFLUXDB_INIT_PASSWORD=

# Redis / Celery. Required by most analysis tabs (ESP, production well
# performance, injection well monitoring, well integrity monitoring) and the
# AI Chat Assistant, which all run as Celery tasks against this broker.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# MongoDB (report storage). Must be filled in even if you don't use the
# report feature -- the app connects to it at startup.
MONGODB_HOST=localhost
MONGODB_PORT=27017

# Grafana (Timeseries Viewer, embedded via iframe). GRAFANA_URL must be
# reachable at this exact URL from your browser -- always access the app via
# http://localhost:<port>, not 127.0.0.1, or the embedded Grafana session
# will keep bouncing back to its login screen.
GF_SECURITY_ALLOW_EMBEDDING=
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_EMAIL=
GF_SECURITY_ADMIN_PASSWORD=
GRAFANA_URL=

# NOTE: Container initialization variables above (MYSQL_DATABASE,
# MYSQL_ROOT_PASSWORD, DOCKER_INFLUXDB_INIT_*) only take effect the FIRST
# time a container initializes its data volume. If you change one of these
# after already starting the stack once, reset the volumes before
# restarting: `docker compose down -v` then `docker compose up -d`.
# Otherwise you'll keep getting errors like "Unknown database 'None'" or
# InfluxDB "401 Unauthorized" even after fixing .env.

# ============================================================================
# OPTIONAL -- only needed for specific features. Safe to leave blank if you
# don't use them.
# ============================================================================

# Report upload/download (MongoDB, GridFS). MONGODB_HOST/PORT are set in the
# Required section above (the app connects at startup regardless). Leave
# MONGODB_USERNAME/PASSWORD and MONGO_INITDB_ROOT_* below all blank for a
# no-auth setup (fine for local development). If you set
# MONGO_INITDB_ROOT_USERNAME/PASSWORD, set MONGODB_USERNAME/PASSWORD to the
# same values or the app will fail to authenticate.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# AI Chat Assistant / RAG pipeline (ChromaDB + Ollama). Setting these values
# only configures which models the app requests -- it does NOT download them.
# Models must be pulled into the running `ollama` container separately before
# use (e.g. `ci\windows\run_ollama_models.bat` or `docker exec -it ollama
# ollama pull <model>`), or requests will fail with "model ... not found, try
# pulling it first". See "Chat Assistant Setup" in start_installation.rst for
# recommended models and how to pull them.
LLM_MODEL_VERSION=
EMBED_MODEL_VERSION=
TRANSLATION_LLM_MODEL=
CHROMADB_HOST=
CHROMADB_PORT=
OLLAMA_HOST=
OLLAMA_PORT=

